# ACT — Neon.tech Postgres connection strings (copy to .env, never commit .env)
#
# From your Neon project dashboard → Connection Details:
#   - Pooled connection  (for the running app — has "-pooler" in the host)
#   - Direct connection  (for prisma migrate — no "-pooler")
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL=""
DIRECT_URL=""

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=""
